# SkillBridge AI — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to Git.

# =============================================================================
# Django
# =============================================================================
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development
FRONTEND_URL=http://localhost:5173

# =============================================================================
# Database (SQLite by default for zero-Docker demo; uncomment DATABASE_URL for PostgreSQL)
# =============================================================================
# DATABASE_URL=postgres://skillbridge:skillbridge_dev_pass@localhost:5433/skillbridge_db
POSTGRES_PORT=5433
POSTGRES_USER=skillbridge
POSTGRES_PASSWORD=
POSTGRES_DB=skillbridge_db

# =============================================================================
# Neo4j (Knowledge Graph — optional; app falls back gracefully if offline)
# =============================================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# =============================================================================
# Redis (Celery Broker — optional for synchronous web demo)
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Vector Store (Qdrant — QDRANT_IN_MEMORY=True works without Docker)
# =============================================================================
QDRANT_URL=http://localhost:6333
QDRANT_IN_MEMORY=True

# =============================================================================
# Adzuna Job Search API (optional when using `manage.py seed_demo_jobs`)
# =============================================================================
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# =============================================================================
# Ollama (LLM Server — LLM_FALLBACK_MODE=True provides deterministic offline fallback)
# =============================================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
LLM_FALLBACK_MODE=True

# =============================================================================
# Speech & NLP Models
# =============================================================================
SPACY_MODEL=en_core_web_sm
WHISPER_MOCK_MODE=False
